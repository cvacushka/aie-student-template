# Example configuration for local runs. Copy to configs/.env only if you need
# private overrides. Do not commit real secrets.

AIRGUARD_APP_NAME=Smart Campus AirGuard
AIRGUARD_MODEL_VERSION=0.1.0
AIRGUARD_LOG_LEVEL=INFO
AIRGUARD_MODEL_PATH=./models/airguard_model.joblib
AIRGUARD_METRICS_PATH=./models/metrics.json
AIRGUARD_EXPERIMENTS_PATH=./models/experiments.csv
AIRGUARD_HOST=127.0.0.1
AIRGUARD_PORT=8000
